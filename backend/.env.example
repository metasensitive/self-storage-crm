APP_NAME="SelfStorage CRM"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Основной домен фронта — используется в ссылках писем (reset-password)
FRONTEND_URL=http://localhost:5173

# Дополнительные origins для CORS через запятую.
# Локальные порты Vite dev (5173) и preview (4173) уже разрешены по умолчанию,
# здесь можно дописать продовые алиасы или другие dev-окружения.
# Пример: CORS_ALLOWED_ORIGINS=https://app.example.com,https://staging.example.com
CORS_ALLOWED_ORIGINS=

LOG_CHANNEL=stack
# На Railway stdout удобнее — логи сразу в дашборде сервиса.
# LOG_CHANNEL=stderr

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=self_storage_crm
DB_USERNAME=postgres
DB_PASSWORD=
# На Railway проще пробросить готовую строку из плагина Postgres:
#   DB_URL=${{Postgres.DATABASE_URL}}
# Тогда DB_HOST/PORT/DATABASE/USERNAME/PASSWORD можно не указывать.
DB_URL=
# Railway-Postgres требует TLS — sslmode=require.
DB_SSLMODE=prefer

# --- Email ---
# Текущий провайдер — Resend (HTTPS-API, не SMTP). Причина: railway/heroku/
# и прочие PaaS блокируют исходящий SMTP egress, а Resend ходит через
# обычный HTTPS и работает откуда угодно. Подробности — в README раздел
# «📧 Email».
#
# Для production:
#   MAIL_MAILER=resend
#   RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxx   (api-key из кабинета resend.com)
#   MAIL_FROM_ADDRESS=onboarding@resend.dev          # sandbox, шлёт только на email владельца аккаунта
#   # или после верификации своего домена в Resend:
#   MAIL_FROM_ADDRESS=noreply@yourdomain.io
#   MAIL_FROM_NAME="SelfStorage CRM"
#
# Для локальной разработки удобно оставить Mailtrap (dev-ловушка — письма
# не уходят реальным адресатам, копятся в inbox на mailtrap.io). См. блок
# ниже — раскомментировать и подставить креды.

MAIL_MAILER=resend
RESEND_API_KEY=
MAIL_FROM_ADDRESS=onboarding@resend.dev
MAIL_FROM_NAME="SelfStorage CRM"

# --- Email в локальной разработке: Mailtrap (опционально) ---
# Раскомментировать и заменить блок Resend выше, если хочется ловить письма
# в mailtrap-inbox вместо реальной отправки.
#
# MAIL_MAILER=smtp
# MAIL_HOST=sandbox.smtp.mailtrap.io
# MAIL_PORT=2525
# MAIL_USERNAME=<из_кабинета_mailtrap>
# MAIL_PASSWORD=<из_кабинета_mailtrap>
# MAIL_ENCRYPTION=tls
# MAIL_FROM_ADDRESS="noreply@selfstorage.local"
# MAIL_FROM_NAME="SelfStorage CRM"

SANCTUM_STATEFUL_DOMAINS=localhost:3000

# Laravel Reverb (WebSocket-сервер для live-обновлений).
# Запускать в отдельном процессе: `php artisan reverb:start`.
# В dev по умолчанию слушает 0.0.0.0:8080. На фронте те же ключи
# должны попасть в `frontend/.env` под `VITE_REVERB_*`.
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http

# ─── Railway-specific (для production-деплоя) ───────────────────────────
# В production Reverb-сервис на Railway сам слушает на $PORT (инжектится),
# а внутри сети сервисы общаются по приватному DNS — *.railway.internal.
# На API-сервисе указываем:
#   REVERB_HOST=reverb.railway.internal   # имя reverb-сервиса в проекте
#   REVERB_PORT=8080
#   REVERB_SCHEME=http
# А клиенту (фронту) нужны публичные значения:
#   VITE_REVERB_HOST=reverb-xxx.up.railway.app
#   VITE_REVERB_PORT=443
#   VITE_REVERB_SCHEME=https
# Сам Reverb-процесс не читает REVERB_HOST/PORT/SCHEME — ему нужны:
#   REVERB_SERVER_HOST=0.0.0.0
#   REVERB_SERVER_PORT=${{PORT}}
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
