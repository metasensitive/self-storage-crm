APP_NAME="SelfStorage CRM"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Основной домен фронта — используется в ссылках писем (reset-password)
FRONTEND_URL=http://localhost:5173

# Дополнительные origins для CORS через запятую.
# Локальные порты Vite dev (5173) и preview (4173) уже разрешены по умолчанию,
# здесь можно дописать продовые алиасы или другие dev-окружения.
# Пример: CORS_ALLOWED_ORIGINS=https://app.example.com,https://staging.example.com
CORS_ALLOWED_ORIGINS=

LOG_CHANNEL=stack

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=self_storage_crm
DB_USERNAME=postgres
DB_PASSWORD=

# --- Email ---
# По умолчанию — Mailtrap (dev-ловушка, письма реальным адресатам не уходят).
# Для production используется Yandex 360 для бизнеса (см. блок ниже).
MAIL_MAILER=smtp
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@selfstorage.local"
MAIL_FROM_NAME="SelfStorage CRM"

# --- Email на проде: личный Yandex.Mail (быстрый старт без своего домена) ---
# Для прода скопируйте этот блок поверх Mailtrap-а и подставьте реальные
# значения. Подробная инструкция — в README раздел «📧 Email».
#
# ВАЖНО: помимо «пароля приложения» нужно ВКЛЮЧИТЬ доступ через почтовый
# клиент в настройках ящика: mail.yandex.* → Все настройки → Почтовые
# программы → ✅ «С сервера imap.yandex.ru по протоколу IMAP» + ✅ «Пароли
# приложений и OAuth-токены». Без этого SMTP вернёт 535 5.7.8 'access rights'.
#
# Хост: smtp.yandex.ru для @yandex.ru, smtp.yandex.com для @yandex.com.
# Когда появится свой домен — USERNAME/FROM_ADDRESS меняются на noreply@yourdomain.ru,
# плюс DNS-настройка SPF/DKIM/DMARC. Тоже в README.
#
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.yandex.ru
# MAIL_PORT=465
# MAIL_USERNAME=your_login@yandex.ru
# MAIL_PASSWORD=<пароль_приложения_с_id.yandex.ru>
# MAIL_ENCRYPTION=ssl
# MAIL_FROM_ADDRESS=your_login@yandex.ru
# MAIL_FROM_NAME="SelfStorage CRM"

SANCTUM_STATEFUL_DOMAINS=localhost:3000

# Laravel Reverb (WebSocket-сервер для live-обновлений).
# Запускать в отдельном процессе: `php artisan reverb:start`.
# В dev по умолчанию слушает 0.0.0.0:8080. На фронте те же ключи
# должны попасть в `frontend/.env` под `VITE_REVERB_*`.
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http
