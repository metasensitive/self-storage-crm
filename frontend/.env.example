# Базовый URL бэкенда. Опционально.
#
# В dev оставьте пустым: запросы пойдут на относительный /api/v1
# и Vite автоматически проксирует их на http://localhost:8000
# (см. vite.config.ts) — CORS при этом не вовлечён.
#
# Для production-сборки укажите полный URL бэкенда.
# Пример (Railway):
#   VITE_API_URL=https://api-xxx.up.railway.app
VITE_API_URL=

# Laravel Reverb (live-обновления через WebSocket).
# Те же app_key, что и в `backend/.env` REVERB_APP_KEY.
# Если оставить пустыми — фронт молча деградирует на refetch/polling.
#
# На Railway хост/порт/схема — публичные значения reverb-сервиса:
#   VITE_REVERB_APP_KEY=<тот же, что REVERB_APP_KEY на бэке>
#   VITE_REVERB_HOST=reverb-xxx.up.railway.app
#   VITE_REVERB_PORT=443
#   VITE_REVERB_SCHEME=https
VITE_REVERB_APP_KEY=
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http
